#!/bin/bash -e

set -x

NAME=symfony
WEBROOT=/var/www/symfony
SKELETON_VERSION=7.4.99
SKELETON_COMMIT=bf1abda299403468285fd4fa0514d916991c9120
SKELETON_SHA256=9dae378ef8e120b2763dd4879c9bb6ecae44592b3be156f3e130c72cc05a266d
FRAMEWORK_VERSION=7.4.17
FRAMEWORK_COMMIT=c7f3c14c51fccba466761e8c0e7dafe4335acc16
SKELETON_URL="https://github.com/symfony/skeleton/archive/$SKELETON_COMMIT.tar.gz"

PHP_INI="/etc/php/?.?/apache2/php.ini /etc/php/?.?/cli/php.ini"
for php_ini in $PHP_INI; do
    sed -i "s|^;date.timezone\(.*\)|date.timezone = 'America/Los_Angeles'|" "$php_ini"
    sed -i "s|^short_open_tag = On|short_open_tag = Off|" "$php_ini"
done

archive=$(mktemp)
curl -fsSL "$SKELETON_URL" -o "$archive"
echo "$SKELETON_SHA256  $archive" | sha256sum --check --status
install -d "$WEBROOT"
tar -xzf "$archive" --strip-components=1 -C "$WEBROOT"
rm -f "$archive"

cd "$WEBROOT"
export COMPOSER_ALLOW_SUPERUSER=1
export COMPOSER_NO_INTERACTION=1
composer install --no-ansi --no-progress --prefer-dist
composer require --no-ansi --no-progress --prefer-dist --with-all-dependencies \
    "symfony/framework-bundle:$FRAMEWORK_VERSION" symfony/orm-pack

installed_version=$(php -r \
    'require "vendor/autoload.php"; echo Symfony\Component\HttpKernel\Kernel::VERSION;')
installed_commit=$(php -r '
    $lock = json_decode(file_get_contents("composer.lock"), true, 512, JSON_THROW_ON_ERROR);
    foreach ($lock["packages"] as $package) {
        if ($package["name"] === "symfony/framework-bundle") {
            echo $package["source"]["reference"];
            exit;
        }
    }
    exit(1);
')
test "$installed_version" = "$FRAMEWORK_VERSION"
test "$installed_commit" = "$FRAMEWORK_COMMIT"

install -m 0644 /usr/local/src/symfony-app/HomeController.php \
    "$WEBROOT/src/Controller/HomeController.php"
rm -rf /usr/local/src/symfony-app

service mysql start
mysqladmin create "$NAME"

# Keep generated credentials out of the build trace. Errexit stays active.
set +x
DB_PASS=$(mcookie)
APP_SECRET=$(mcookie)
mysql --batch <<EOF
CREATE USER '$NAME'@'localhost' IDENTIFIED BY '$DB_PASS';
GRANT ALL PRIVILEGES ON $NAME.* TO '$NAME'@'localhost';
USE $NAME;
CREATE TABLE turnkey_status (
    id INT PRIMARY KEY,
    message VARCHAR(128) NOT NULL
);
INSERT INTO turnkey_status (id, message)
VALUES (1, 'Database connectivity verified');
FLUSH PRIVILEGES;
EOF
cat > "$WEBROOT/.env.local" <<EOF
APP_ENV=prod
APP_SECRET=$APP_SECRET
DATABASE_URL="mysql://$NAME:$DB_PASS@127.0.0.1:3306/$NAME"
EOF
chmod 0640 "$WEBROOT/.env.local"
chown root:www-data "$WEBROOT/.env.local"
unset DB_PASS APP_SECRET
set -x

install -d /usr/local/share/turnkey-symfony
cat > /usr/local/share/turnkey-symfony/source <<EOF
skeleton_version=$SKELETON_VERSION
skeleton_commit=$SKELETON_COMMIT
skeleton_sha256=$SKELETON_SHA256
skeleton_url=$SKELETON_URL
framework_version=$FRAMEWORK_VERSION
framework_commit=$FRAMEWORK_COMMIT
framework_tag=v$FRAMEWORK_VERSION
framework_url=https://github.com/symfony/framework-bundle.git
composer_lock_sha256=$(sha256sum composer.lock | awk '{print $1}')
EOF

a2dissite 000-default
a2ensite symfony
a2enmod headers

chown -R root:root "$WEBROOT"
chown -R www-data:www-data "$WEBROOT/var"
runuser -u www-data -- php bin/console cache:clear --env=prod --no-debug

service mysql stop
